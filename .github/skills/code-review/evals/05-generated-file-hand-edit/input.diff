+    it("should score an elif chain inside a loop as one structural if plus flat elif/else", () => {
+      const sourceCode = `
+def bucket(scores):
+    for score in scores:
+        if score >= 90:
+            yield "A"
+        elif score >= 80:
+            yield "B"
+        else:
+            yield "F"
+`;
+      const results = PythonMetricsAnalyzer.analyzeFile(sourceCode);
+      assert.strictEqual(results.length, 1);
+      assert.strictEqual(results[0].complexity, 5, "for(1) + if(2) + elif(1) + else(1)");
+      assert.deepStrictEqual(
+        results[0].details.map((d: UnifiedMetricsDetail) => d.reason),
+        ["for loop", "if statement", "elif clause", "else clause"]
+      );
+      for (const d of results[0].details.filter((x: UnifiedMetricsDetail) => x.reason !== "if statement" && x.reason !== "for loop")) {
+        assert.strictEqual(d.increment, 1, `${d.reason} must be flat +1`);
+      }
+    });
